# ============================================================
# MARABAGAM PLATFORM ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to '.env' for local custom overrides.
# Do NOT commit '.env' containing real secrets to version control.

# ------------------------------------------------------------
# General & Application Environment
# ------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------
# Host Ports Configuration (Cross-Platform Customizable)
# ------------------------------------------------------------
FRONTEND_PORT=5173
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
POSTGRES_PORT=5432

# ------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------
POSTGRES_DB=marabagam_db
POSTGRES_USER=marabagam_user
POSTGRES_PASSWORD=marabagam_dev_password
DB_HOST=postgres
DB_PORT=5432
DB_NAME=marabagam_db
DB_USERNAME=marabagam_user
DB_PASSWORD=marabagam_dev_password

# ------------------------------------------------------------
# Backend Configuration (Spring Boot)
# ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
AI_SERVICE_URL=http://ai-service:8000
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=604800000

# ------------------------------------------------------------
# Frontend Configuration (React / Vite)
# ------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_AI_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------
# AI Service Configuration (FastAPI)
# ------------------------------------------------------------
AI_SERVICE_NAME=marabagam-ai
AI_SERVICE_HOST=0.0.0.0
